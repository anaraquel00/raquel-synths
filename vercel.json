{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,

  "functions": {
    "api/index.js": {
      "includeFiles": "dist/raquel-synths/**"
    }
  },

  "routes": [
    {
      "src": "^/$",
      "dest": "/api/index.js"
    },
    {
      "src": "/lore-reader/(.*)",
      "has": [
        {
          "type": "query",
          "key": "mode",
          "value": "jonah"
        }
      ],
      "continue": true,
      "transforms": [
        {
          "type": "request.query",
          "op": "delete",
          "target": {
            "key": "mode"
          }
        },
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-rqs-legacy-mode"
          },
          "args": "jonah"
        }
      ]
    },
    {
      "src": "/lore-reader/(.*)",
      "has": [
        {
          "type": "header",
          "key": "x-rqs-legacy-mode",
          "value": "jonah"
        }
      ],
      "headers": {
        "Location": "/lore/jonah/$1"
      },
      "status": 308
    },
    {
      "src": "/lore-reader/(.*)",
      "headers": {
        "Location": "/lore/broklin/$1"
      },
      "status": 308
    }
  ],

  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.js"
    },

    {
      "source": "/lore/:mode/:id*",
      "destination": "/api/index.js"
    },

    {
      "source": "/hybrid-reader/:id*",
      "destination": "/api/index.js"
    },

    {
      "source": "/log-reader/:id*",
      "destination": "/api/index.js"
    },

    {
      "source": "/((?!api(?:/|$)|.*\\.[^/]+$).*)",
      "destination": "/api/index.js"
    }
  ]
}
