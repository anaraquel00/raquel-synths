{
  "version": 2,

  "functions": {
    "api/index.js": {
      "includeFiles": "dist/raquel-synths/**"
    }
  },

  "redirects": [
    {
      "source": "/lore-reader/:id*",
      "has": [
        {
          "type": "query",
          "key": "mode",
          "value": "jonah"
        }
      ],
      "destination": "/lore/jonah/:id*",
      "permanent": true
    },
    {
      "source": "/lore-reader/:id*",
      "destination": "/lore/broklin/:id*",
      "permanent": true
    }
  ],

  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.js"
    },

    {
      "source": "/lore/:mode/:id*",
      "destination": "/api/index.js"
    },

    {
      "source": "/hybrid-reader/:id*",
      "destination": "/api/index.js"
    },

    {
      "source": "/log-reader/:id*",
      "destination": "/api/index.js"
    },

    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
